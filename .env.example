# ==============================================================
# Ncore Film & Sorozat Letöltő - Környezeti Változók Sablon
# Másold le ezt a fájlt '.env' néven és töltsd ki a saját adataiddal!
# ==============================================================

# --------------------------------------------------------------
# 1. TMDB (The Movie Database) Beállítások
# Ingyenes API kulcs igénylése: https://www.themoviedb.org/settings/api
# --------------------------------------------------------------
TMDB_API_KEY=ide_ird_a_tmdb_api_kulcsodat
TMDB_LANGUAGE=hu-HU

# --------------------------------------------------------------
# 2. nCore Hozzáférés
# Figyelem: Soha ne töltsd fel a jelszavadat GitHubra!
# --------------------------------------------------------------
NCORE_USERNAME=felhasznaloneved
NCORE_PASSWORD=jelszavad
# Opcionális 2FA kulcs vagy cookie, ha szükséges:
NCORE_PASSKEY=

# --------------------------------------------------------------
# 3. Torrent Kliens Beállítások (qBittorrent ajánlott)
# qBittorrent: Beállítások -> Web UI engedélyezése
# --------------------------------------------------------------
TORRENT_CLIENT=qbittorrent # qbittorrent vagy utorrent
QBITTORRENT_HOST=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# nCore Hit & Run (HnR) / Seedelési szabályok
# Minimum seedelési idő órában (pl. nCore alap: 48 óra)
MIN_SEED_TIME_HOURS=48
# Vagy elérési arány (pl. 1.0)
TARGET_RATIO=1.0
# Automatikus leállítás/törlés a kliensből a seedelési szabály teljesülésekor
AUTO_REMOVE_AFTER_SEED=true

# --------------------------------------------------------------
# 4. Könyvtárak és Mappák Útvonalai
# Itt adhatod meg a letöltési és végleges Plex mappákat
# --------------------------------------------------------------
# Ideiglenes letöltési mappa (ahova a qBittorrent közvetlenül tölt):
DOWNLOAD_TEMP_DIR=D:/Torrents/Downloading

# Végleges Plex média mappák:
PLEX_MOVIES_DIR=D:/Media/Movies
PLEX_SERIES_DIR=D:/Media/TV Shows

# --------------------------------------------------------------
# 5. Felirat Kereső (OpenSubtitles / Feliratok.info)
# Ha nincs szinkron, ezekből töltünk le magyar feliratot
# --------------------------------------------------------------
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# --------------------------------------------------------------
# 6. Plex Médiaszerver Integráció
# Plex API Token megszerzése: https://support.plex.tv/articles/204059436/
# --------------------------------------------------------------
PLEX_SERVER_URL=http://localhost:32400
PLEX_TOKEN=ide_ird_a_plex_tokent
AUTO_REFRESH_PLEX=true

# --------------------------------------------------------------
# 7. Alkalmazás / WebUI Beállítások
# --------------------------------------------------------------
APP_PORT=8501
APP_HOST=0.0.0.0
DEBUG_MODE=false
